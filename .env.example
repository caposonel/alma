# Vercel Analytics (auto-detected on Vercel, no key needed)

# Site URL (used by sitemap.xml + Open Graph metadata base URL)
NEXT_PUBLIC_SITE_URL=https://almagov.co.il

# ---------------------------------------------------------------------------
# Admin panel (custom CMS at /admin)
# ---------------------------------------------------------------------------
# Generate ADMIN_PASSWORD_HASH_B64 + AUTH_SECRET locally with:
#   npm run admin:password
# Then paste the printed lines into .env.local (or Vercel env settings).
#
# IMPORTANT: use `ADMIN_PASSWORD_HASH_B64` (base64-encoded), NOT the legacy
# raw `ADMIN_PASSWORD_HASH`. bcrypt hashes contain `

 sequences (e.g.
# `

10
`) that Next 16's bundled dotenv-expand interprets as variable
# references and strips, mangling the hash. Base64 sidesteps the entire
# parsing layer. The legacy var is still read as a fallback for
# backwards-compat, but new setups should use B64.
ADMIN_USERNAME=alma
ADMIN_PASSWORD_HASH_B64=
# Legacy — use ADMIN_PASSWORD_HASH_B64 above for new setups.
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Vercel KV (production storage for the admin panel content)
# ---------------------------------------------------------------------------
# Leave blank for local development — the admin panel will fall back to
# `data/content.json` (gitignored). Vercel injects these automatically when
# you attach a KV / Upstash Redis integration to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# ---------------------------------------------------------------------------
# Vercel Blob (image uploads from the admin panel)
# ---------------------------------------------------------------------------
# Leave blank for local development — uploads go to public/uploads/ (gitignored)
# instead. In production, attach a Blob store via the Vercel dashboard and the
# token is injected automatically.
BLOB_READ_WRITE_TOKEN=
